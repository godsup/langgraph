# Generated by stackit-migration-agents (run {{ m.run_id }}). Review before applying.
terraform {
  required_version = "{{ terraform_version }}"

  required_providers {
    stackit = {
      source  = "stackitcloud/stackit"
      version = "{{ provider_version }}"
    }
  }
}

# Authentication comes from the environment, never from this file:
# STACKIT_SERVICE_ACCOUNT_KEY_PATH (key flow) or workload identity federation.
provider "stackit" {
  default_region = var.region
}
