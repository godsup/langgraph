# Copy to .env (git-ignored) and fill in. Secrets are read from here or from the
# environment only; they never appear in prompts, logs or the audit log.

# --- LLM: any OpenAI-compatible endpoint ----------------------------------
# OpenAI (default): leave LLM_BASE_URL empty.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
# Structured output method: function_calling (widest support) | json_schema | json_mode
LLM_STRUCTURED_METHOD=function_calling

# Preset: STACKIT AI Model Serving (OpenAI-compatible). Uncomment to switch;
# no code changes needed. Create the token in the STACKIT portal or with
# terraform (stackit_modelserving_token). Pick a model id from the
# STACKIT Model Serving catalogue (TODO: confirm the model id for your project).
# LLM_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
# LLM_API_KEY=<STACKIT model serving auth token>
# LLM_MODEL=<model id, e.g. a Llama or Mistral instruct model from the catalogue>

# --- Checkpointing (runs survive restarts) ----------------------------------
CHECKPOINT_BACKEND=sqlite
# CHECKPOINT_SQLITE_PATH=runs/checkpoints.sqlite
# CHECKPOINT_BACKEND=postgres
# CHECKPOINT_POSTGRES_DSN=postgresql://user:password@localhost:5432/migrate

# --- Approvals -----------------------------------------------------------
# Optional. Unset = random per-process secret (tokens die with the process).
# APPROVAL_SECRET=
APPROVAL_TTL_S=900

# --- Source: AWS (READ-ONLY credentials, see docs/aws-readonly-policy.json) ---
AWS_REGION=eu-central-1
# Use a profile or the standard AWS_* variables:
# AWS_PROFILE=migration-readonly
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Target: STACKIT (service account scoped to ONE project) ------------------
STACKIT_PROJECT_ID=
STACKIT_REGION=eu01
STACKIT_SERVICE_ACCOUNT_KEY_PATH=
# STACKIT_PRIVATE_KEY_PATH=
# Linux image UUID for migrated servers (`stackit image list`) and SSH key:
STACKIT_IMAGE_ID=
SSH_PUBLIC_KEY_PATH=

# --- Deployment in PR mode ----------------------------------------------------
# PR_REPO=client-org/infrastructure
# PR_BASE_BRANCH=main
# PR_REPO_PATH=/path/to/local/clone
# GH_TOKEN=

# --- Data migration -----------------------------------------------------------
VERIFY_SAMPLE_SIZE=20
# One pair per database, named after the source DB (shop-db -> SHOP_DB).
# Values from the RDS endpoint / Secrets Manager and the sensitive terraform
# outputs (`terraform output -raw shop_db_password`). Never commit them.
# PG_DSN_SOURCE_SHOP_DB=postgresql://user:password@source-host:5432/shop?sslmode=require
# PG_DSN_TARGET_SHOP_DB=postgresql://shop_owner:password@target-host:5432/shop?sslmode=require
# With a single database, SOURCE_PG_DSN / TARGET_PG_DSN work as well.
STACKIT_S3_ENDPOINT=https://object.storage.eu01.onstackit.cloud
# STACKIT_S3_ACCESS_KEY_ID=
# STACKIT_S3_SECRET_ACCESS_KEY=

# --- Monitoring -----------------------------------------------------------------
# OBSERVABILITY_URL=<metrics_url of your STACKIT Observability instance>
# OBSERVABILITY_USERNAME=
# OBSERVABILITY_PASSWORD=
MONITOR_INTERVAL_S=60
# WEBHOOK_KIND=slack   # or teams
# WEBHOOK_URL=
